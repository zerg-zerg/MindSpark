# MindSpark - self-hosted server configuration.
# Copy to `.env` (git-ignored) and edit. docker-compose.yml reads this file.

PORT=3000
DBPATH=./data/

# Host port that docker-compose publishes (the container always listens on 3000
# internally). Ignored when you run `node server.js` directly.
HOST_PORT=3000

# --- authentication --------------------------------------------------------
# The first administrator, created on startup if the username does not exist.
# ADMIN_PASSWORD is required for a fresh instance; without it (and with no
# other users) nobody can sign in. Once the admin exists, changing the password
# here has NO effect - set ADMIN_PASSWORD_RESET=1 for one start to force it.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# How long a sign-in lasts, in days (default 30).
SESSION_TTL_DAYS=30

# --- optional --------------------------------------------------------------
# Extra origins allowed by connect-src (custom LLM providers, etc.), space-separated:
# EXTRA_CONNECT_SRC="http://localhost:11434 https://api.mistral.ai"

# Bearer token for the machine-only POST /api/import endpoint (GPT integration).
# IMPORT_TOKEN=
